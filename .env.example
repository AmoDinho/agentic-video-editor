# Copy to .env. Never commit .env.
#
# Footage folders are NOT listed here. Put them in media-folders.txt.
# `make up` generates docker-compose.override.yml from that file.

EXPORT_DIR=${HOME}/Movies/Rough Cuts
CACHE_DIR=/cache
PROJECTS_DIR=/cache/projects

# Local model endpoints. Model Runner is the default and uses the Mac GPU.
MODEL_RUNNER_URL=http://model-runner.docker.internal/engines/v1
OLLAMA_URL=http://host.docker.internal:11434
AGENT_MODEL=ai/qwen2.5:7B-Q4_K_M
VISION_MODEL=ai/qwen2.5vl:3B

# Optional. Keys can also be entered in Settings, where they are encrypted
# in the local database and never written to logs.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

DATABASE_URL=postgresql://ave:ave@db:5432/ave
REDIS_URL=redis://redis:6379/0
WHISPER_MODEL=small
FAST_SIDECAR_URL=http://host.docker.internal:8077
